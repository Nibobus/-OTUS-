--Длина маршрута, соединяющего Эйфелеву башню и Лувр
WITH eiffel AS (
    SELECT location
    FROM landmarks
    WHERE name = 'Эйфелева башня'),
louvre AS (
    SELECT location
    FROM landmarks
    WHERE name = 'Лувр')
SELECT ST_Length(r.route::geography) AS length_meters
FROM routes AS r
CROSS JOIN eiffel AS e
CROSS JOIN louvre AS l
WHERE (
  ST_Equals(r.start_location, e.location)
  AND ST_Equals(r.end_location, l.location))
OR (
  ST_Equals(r.start_location, l.location)
  AND ST_Equals(r.end_location, e.location));
